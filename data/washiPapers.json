      "designations": [
        "dento"
      ],
      "desc": "五箇山・八尾などで漉かれる富山の和紙の総称。障子紙から型染めの民藝紙まで幅が広く、雪深い土地の楮を活かした強い紙で知られる。"
    },
    "ogunigami": {
      "name": "小国紙",
