      ],
      "desc": "楮の最高級厚紙。人間国宝・岩野市兵衛家が漉き継ぎ、浮世絵の復刻や版画用紙として世界の版画家に求められる。重要無形文化財。"
    },
    "echizen-torinoko": {
      "name": "越前鳥の子紙",
      "reading": "えちぜんとりのこし",
      "category": "designated",
      "regionLabel": "福井県越前市",
      "designations": [
        "juyo"
      ],
      "desc": "雁皮を主原料とする滑らかで丈夫な紙。卵殻色の紙肌から「鳥の子」と呼ばれ、料紙・襖紙の最高級品。重要無形文化財。"
    },
    "uchiyamagami": {
      "name": "内山紙",
      "reading": "うちやまがみ",
      "category": "designated",
