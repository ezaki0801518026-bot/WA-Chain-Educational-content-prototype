      "designations": [
        "sentaku"
      ],
      "desc": "豪雪地帯の「雪さらし」で仕上げる楮紙。雪上に紙を広げて日光で自然漂白する製法が特徴で、柔らかな白と強さを併せ持つ。"
    },
    "echizen-washi": {
      "name": "越前和紙",
      "reading": "えちぜんわし",
      "category": "designated",
      "regionLabel": "福井県越前市今立",
      "designations": [
        "dento"
      ],
      "desc": "1500年の歴史を誇る日本最大級の産地。紙の神「川上御前」を祀り、奉書・鳥の子・襖紙・美術用紙まで、あらゆる高級紙を漉き分ける。"
    },
    "echizen-hosho": {
      "name": "越前奉書",
      "reading": "えちぜんほうしょ",
