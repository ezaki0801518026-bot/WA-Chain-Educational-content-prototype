  "papers": {
    "kozoshi": {
      "name": "楮紙",
      "reading": "こうぞし",
      "category": "raw",
      "regionLabel": "那須・土佐・石州 ほか",
      "desc": "日本で最も多く使われる和紙。太く強靭な繊維をもち、打紙加工や、米粉・胡粉などの填料を加えることで表情が大きく変わる。強度を要する和紙の中心的な存在。"
    },
    "ganpishi": {
      "name": "雁皮紙",
      "reading": "がんぴし",
      "category": "raw",
      "regionLabel": "野生のジンチョウゲ科（栽培困難）",
      "desc": "和紙のなかで最もなめらかで光沢があり、書写料紙として最上とされる。半透明で緻密なため虫害が少なく、記録保存にも適す。振ると甲高い音が鳴るのも特徴。"
    },
    "mitsumatashi": {
      "name": "三椏紙",
      "reading": "みつまたし",
      "category": "raw",
      "regionLabel": "日本各地（近世以降に栽培普及）",
      "desc": "雁皮ほどではないが光沢がある。繊維の強度は楮や雁皮にやや劣るが柔らかく、箔下紙などに使われた。"
    },
    "mashi": {
      "name": "麻紙",
      "reading": "まし",
      "category": "raw",
      "regionLabel": "中国由来（古代に日本へ）",
      "desc": "大麻や苧麻の繊維を用いた、中国から伝わった最も古い紙。繊維が非常に長く強靭だが抄紙に手間がかかり、平安時代以降は衰退。古代には広く使われた。"
    },
    "kongoshi": {
      "name": "混合紙",
      "reading": "こんごうし",
      "category": "raw",
      "regionLabel": "—",
      "desc": "楮と雁皮、三椏と楮など、複数の植物繊維を混合して漉いた紙。それぞれの繊維の特徴を併せ持つ。"
    },
    "misugami": {
      "name": "美栖紙",
      "reading": "みすがみ",
      "category": "regional",
      "regionLabel": "奈良県吉野町",
      "desc": "楮に胡粉や白土を混入した打紙。漉いた紙を板床に重ねて脱水し乾燥板で自然乾燥させる「簀伏せ」により、非常にやわらかく仕上がる。掛軸の増裏・中裏の裏打ち紙に用いる。「表具用手漉和紙（美栖紙）製作」として国の選定保存技術に選定されている。",
      "designations": [
        "hozon"
      ]
    },
    "udagami": {
      "name": "宇陀紙",
      "reading": "うだがみ",
      "category": "regional",
      "regionLabel": "奈良県吉野町",
      "desc": "楮に白土を添加した紙。防虫効果があり、表装後に狂い（反りや波打ち）が生じにくい。掛軸の最後の裏打ちである総裏紙として重用される。「表具用手漉和紙（宇陀紙）製作」として国の選定保存技術に選定されている。",
      "designations": [
        "hozon"
      ]
    },
    "suiharashi": {
      "name": "杉原紙",
      "reading": "すいはらし",
      "category": "regional",
      "regionLabel": "播磨国（兵庫県）杉原谷",
      "desc": "楮を原料とした紙。播磨・杉原谷が発祥とされ、中世には武家文書などとして広く使われた。"
    },
    "danshi": {
      "name": "檀紙 / 布目紙",
      "reading": "だんし / ぬのめがみ",
      "category": "regional",
      "regionLabel": "陸奥（東北）・讃岐 ほか",
      "desc": "高級紙として珍重された。布目紙は麻布や絹布の間に湿紙を挟み圧搾して布目模様をつけたもの。近世初頭までの檀紙はこの布目紙で、現在の檀紙は乾燥の工夫で皺を寄せたもの。"
    },
    "hoshogami": {
      "name": "奉書紙",
      "reading": "ほうしょがみ",
      "category": "regional",
      "regionLabel": "—",
      "desc": "米粉を填料として加えた楮紙。老中奉書などの公文書や高級な浮世絵に用いた。米粉ゆえ虫害に遭いやすく、現在は滑石（タルク）で代用されることが多い。"
    },
    "doroiri": {
      "name": "泥（土）入り間似合紙",
      "reading": "どろいりまにあいがみ",
      "category": "regional",
      "regionLabel": "—",
      "desc": "雁皮繊維に土（粘土）を添加して漉いた紙。表面が平滑で、水を通しても伸縮が抑えられる。色合わせ（間似合）などの装飾紙として作られ、襖の装飾にも用いる。"
    },
    "kumogami": {
      "name": "雲紙・飛雲紙・羅文紙",
      "reading": "くもがみ ほか",
      "category": "decorative",
      "regionLabel": "—",
      "desc": "染め紙の技法の応用。雲紙は紙の上下2箇所に藍や紫の繊維を流し込み、飛雲紙は雲の形に散らし、羅文紙は着色繊維で網目状の文様を作った緻密な紙。"
    },
    "suminagashi": {
      "name": "墨流し",
      "reading": "すみながし",
      "category": "decorative",
      "regionLabel": "—",
      "desc": "水面に墨汁を落とし、松脂などで拡散させてできる流動的な文様を、紙に写し取った装飾紙。"
    },
    "tsugigami": {
      "name": "継ぎ紙",
      "reading": "つぎがみ",
      "category": "decorative",
      "regionLabel": "—",
      "desc": "種類・色彩・装飾の異なる紙を、破り継ぎや重ね継ぎで一枚に繋ぎ合わせたもの。西本願寺『三十六人家集』に見られる華麗な意匠が特徴。"
    },
    "karakami": {
      "name": "唐紙",
      "reading": "からかみ",
      "category": "decorative",
      "regionLabel": "京都（京唐紙）・江戸（江戸唐紙）",
      "desc": "もとは唐（中国）渡来の紙で、のち日本で模造された。胡粉を引いた紙の上に、雲母（きら）で版木文様を刷った装飾紙。"
    },
    "chiyogami": {
      "name": "千代紙",
      "reading": "ちよがみ",
      "category": "decorative",
      "regionLabel": "—",
      "desc": "さまざまな文様を木版で色刷りした紙。江戸時代に錦絵の影響を受けて発展した。"
    },
    "senshi": {
      "name": "宣紙 / 竹紙",
      "reading": "せんし / ちくし",
      "category": "imported",
      "regionLabel": "中国からの輸入",
      "desc": "中国から輸入された、竹や青檀・稲藁などを原料とする紙。日本では主に書や水墨画に用いられ、江戸時代に国産の画仙紙が作られるきっかけともなった。"
    },
    "etchu-washi": {
      "name": "越中和紙",
      "reading": "えっちゅうわし",
